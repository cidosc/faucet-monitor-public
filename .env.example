# Copy to .env; never commit credentials or personal configuration.
# See README.md before enabling network jobs, notifications, or signing.
# Generate separate random values for SECRET_KEY, database and dashboard passwords.
APP_ENV=production
TZ=UTC
LOG_LEVEL=INFO
LOG_FORMAT=json
SECRET_KEY=

POSTGRES_USER=faucet
POSTGRES_PASSWORD=
POSTGRES_DB=faucet
DATABASE_URL=postgresql+psycopg://faucet:CHANGE_ME@db:5432/faucet
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

DASHBOARD_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

RUN_SCHEDULER=false
FAUCET_PROBE_INTERVAL_MIN=20
DISCOVER_INTERVAL_HOURS=24
ELIGIBILITY_INTERVAL_HOURS=6
CLAIM_READINESS_INTERVAL_MIN=30
DETECT_INCOMING_INTERVAL_MIN=30
COST_REFRESH_INTERVAL_MIN=60
DAILY_SUMMARY_HOUR=9
RETENTION_INTERVAL_HOURS=24
JOB_TIMEOUT_SECONDS=600

DETECT_CHAINS=base,arbitrum,polygon,zksync,ethereum,plasma
SCAN_CHUNK_BLOCKS=10000
SCAN_MAX_CHUNKS=12
SCAN_MAX_TRANSFERS=100

HTTP_TIMEOUT_SECONDS=15
HTTP_CONNECT_TIMEOUT_SECONDS=8
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE=1.5
HTTP_BACKOFF_MAX_SECONDS=60
HTTP_USER_AGENT=FaucetMonitor/1.0 (+contact: you@example.com)
HTTP_MAX_CONCURRENT=4
RATE_LIMIT_PER_HOST_PER_MIN=6
RESPECT_ROBOTS_TXT=true
VERIFY_TLS=true

HTTP_PROXY_URL=
HTTP_PROXY_FALLBACK=true

RPC_ETHEREUM=https://ethereum-rpc.publicnode.com
RPC_BASE=https://base-rpc.publicnode.com
RPC_ARBITRUM=https://arbitrum-one-rpc.publicnode.com
RPC_OPTIMISM=https://optimism-rpc.publicnode.com
RPC_POLYGON=https://polygon-bor-rpc.publicnode.com
RPC_BNB=https://bsc-rpc.publicnode.com

RPC_PLASMA=https://rpc.plasma.to

RPC_LINEA=https://linea-rpc.publicnode.com
RPC_SCROLL=https://scroll-rpc.publicnode.com
RPC_UNICHAIN=https://unichain-rpc.publicnode.com
RPC_SONIC=https://sonic-rpc.publicnode.com
RPC_MANTLE=https://mantle-rpc.publicnode.com
RPC_BERACHAIN=https://berachain-rpc.publicnode.com
RPC_CELO=https://celo-rpc.publicnode.com
RPC_GNOSIS=https://gnosis-rpc.publicnode.com
RPC_ZKSYNC=

RPC_ETH_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
RPC_BASE_SEPOLIA=https://base-sepolia-rpc.publicnode.com
RPC_ARB_SEPOLIA=https://arbitrum-sepolia-rpc.publicnode.com
RPC_OP_SEPOLIA=https://optimism-sepolia-rpc.publicnode.com
RPC_POLYGON_AMOY=https://polygon-amoy-bor-rpc.publicnode.com
RPC_BSC_TESTNET=https://bsc-testnet-rpc.publicnode.com

RPC_TIMEOUT_SECONDS=10
RPC_MAX_RETRIES=2

PRICE_PROVIDER=static
STATIC_PRICES_JSON={"ETH":0,"MATIC":0}
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

NOTIFY_ENABLED=false
NOTIFY_CHANNELS=
NOTIFY_MIN_INTERVAL_SECONDS=300
NOTIFY_MAX_PER_HOUR=12

FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
WECOM_WEBHOOK_URL=
SERVERCHAN_SENDKEY=
BARK_URL=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_SSL=true

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_PROXY=
TELEGRAM_POLL_ENABLED=false

GLOBAL_AUTO_CLAIM=false
AUTO_CLAIM_DRY_RUN=true
AUTO_CLAIM_REQUIRE_ALLOWLIST=true
AUTO_CLAIM_MAX_RETRIES=2
AUTO_CLAIM_MIN_INTERVAL_SECONDS=300
AUTO_CLAIM_MAX_USD=0

CLAIM_GAS_MAX_GWEI=30
CLAIM_COST_MAX_USD=5

RETAIN_FAUCET_CHECKS_DAYS=90
RETAIN_NOTIFICATIONS_DAYS=180
RETAIN_SCAN_LOGS_DAYS=30
RETAIN_ELIGIBILITY_PER_PAIR=10

DISCOVERY_ENABLED_SOURCES=manual,rss
GITHUB_TOKEN=

